// The inverse student-user relation is a list to accommodate Prisma 6 composite relation validation.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model applications {
  application_id    BigInt           @id @default(autoincrement())
  student_id        BigInt
  listing_id        BigInt
  status            String           @default("submitted")
  match_score       Decimal?         @db.Decimal(5, 2)
  cover_note        String?
  submitted_at      DateTime         @default(now()) @db.Timestamptz(6)
  status_changed_at DateTime         @default(now()) @db.Timestamptz(6)
  updated_at        DateTime         @default(now()) @db.Timestamptz(6)
  listings          listings         @relation(fields: [listing_id], references: [listing_id], onUpdate: NoAction)
  student_profiles  student_profiles @relation(fields: [student_id], references: [student_id], onUpdate: NoAction)
  messages          messages[]
  placements        placements?

  @@unique([student_id, listing_id], map: "uq_applications_student_listing")
  @@index([listing_id, status], map: "ix_applications_listing")
  @@index([student_id, status], map: "ix_applications_student")
}

